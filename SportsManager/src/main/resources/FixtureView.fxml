<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-border-color: PINK; -fx-background-color: LIGHTYELLOW;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sportsmanager.ui.FixtureController">
    <children>
        <Label fx:id="leaguenamelabel" alignment="CENTER" contentDisplay="CENTER" layoutX="100.0" layoutY="20.0" prefHeight="34.0" prefWidth="400.0" text="..." textFill="#009487" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="20.0">
            <font><Font size="17.0" /></font>
            <effect><Glow level="0.96" /></effect>
        </Label>
        <HBox alignment="CENTER" layoutY="55.0" prefHeight="28.0" spacing="14.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="55.0">
            <children>
                <Button mnemonicParsing="false" onMouseClicked="#prevweekbutton" prefWidth="40.0" text="◀" />
                <Label fx:id="weeklabel" alignment="CENTER" prefWidth="160.0" text="Week 1 / 1" textFill="#777777">
                    <font><Font size="12.0" /></font>
                </Label>
                <Button mnemonicParsing="false" onMouseClicked="#nextweekbutton" prefWidth="40.0" text="▶" />
            </children>
        </HBox>
        <TableView fx:id="fixturetable" layoutX="14.0" layoutY="95.0" prefHeight="260.0" prefWidth="572.0" AnchorPane.bottomAnchor="55.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="95.0">
            <columns>
                <TableColumn fx:id="hometeamcol" prefWidth="240.0" text="Home" />
                <TableColumn fx:id="scorecol" prefWidth="80.0" text="Score" />
                <TableColumn fx:id="awayteamcol" prefWidth="240.0" text="Away" />
            </columns>
        </TableView>
        <Button layoutX="22.0" layoutY="343.0" mnemonicParsing="false" onMouseClicked="#returnbutton" prefHeight="34.0" prefWidth="55.0" text="Back" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="22.0" />
        <Button layoutX="530.0" layoutY="352.0" mnemonicParsing="false" onMouseClicked="#exitbutton" prefHeight="33.0" prefWidth="55.0" text="Exit" AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="14.0" />
    </children>
    <effect>
        <DropShadow>
            <color>
                <Color red="0.0873294323682785" green="0.8421052694320679" blue="0.26344379782676697" />
            </color>
        </DropShadow>
    </effect>
</AnchorPane>
