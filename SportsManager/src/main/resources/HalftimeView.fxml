<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="570.0" prefWidth="500.0" style="-fx-border-color: PINK; -fx-background-color: LIGHTYELLOW;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sportsmanager.ui.HalftimeController">
    <children>

        <!-- Title -->
        <Label fx:id="titleLabel" alignment="CENTER" layoutX="150.0" layoutY="12.0" prefHeight="30.0" prefWidth="200.0" text="HALF TIME" textFill="#009487" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="12.0">
            <font><Font size="16.0" /></font>
            <effect><Glow level="0.96" /></effect>
        </Label>

        <!-- Score panel -->
        <VBox alignment="CENTER" layoutX="50.0" layoutY="48.0" prefWidth="400.0" spacing="3.0" style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 6; -fx-padding: 8; -fx-border-color: #888; -fx-border-radius: 6;" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="48.0">
            <children>
                <Label fx:id="scorelabel" style="-fx-font-weight: bold; -fx-font-size: 16;" text="-" />
                <Label fx:id="firsthalfsumlabel" style="-fx-font-size: 10; -fx-text-fill: #555;" text="" />
            </children>
        </VBox>

        <!-- Tactic section -->
        <Label layoutX="50.0" layoutY="136.0" style="-fx-text-fill: #555; -fx-font-size: 10;" text="Current Tactic" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="136.0" />
        <Label fx:id="currenttacticlabel" layoutX="50.0" layoutY="150.0" style="-fx-font-weight: bold; -fx-font-size: 12;" text="-" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="150.0" />
        <Label fx:id="switchTacticLabel" layoutX="50.0" layoutY="174.0" style="-fx-text-fill: #555; -fx-font-size: 10;" text="Switch Tactic for 2nd Half" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="174.0" />
        <ListView fx:id="tacticlist" layoutX="50.0" layoutY="190.0" prefHeight="90.0" prefWidth="400.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="190.0" />
        <Button layoutX="50.0" layoutY="288.0" mnemonicParsing="false" onMouseClicked="#applybutton" prefHeight="28.0" prefWidth="160.0" style="-fx-background-color: SKYBLUE; -fx-font-weight: bold;" text="Apply Tactic" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="288.0" />

        <Separator layoutX="50.0" layoutY="326.0" prefWidth="400.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="326.0" />

        <!-- Substitution section -->
        <Label layoutX="50.0" layoutY="336.0" style="-fx-font-weight: bold; -fx-font-size: 11;" text="Substitutions" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="336.0" />
        <Label fx:id="subsRemainingLabel" layoutX="280.0" layoutY="336.0" style="-fx-font-size: 10; -fx-text-fill: #555;" text="" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="336.0" />

        <Label layoutX="50.0" layoutY="356.0" style="-fx-text-fill: #555; -fx-font-size: 10;" text="Player Out (In Game)" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="356.0" />
        <Label layoutX="260.0" layoutY="356.0" style="-fx-text-fill: #555; -fx-font-size: 10;" text="Player In (Bench)" AnchorPane.leftAnchor="260.0" AnchorPane.topAnchor="356.0" />

        <ListView fx:id="playerOutList" layoutX="50.0" layoutY="372.0" prefHeight="110.0" prefWidth="195.0" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="372.0" />
        <ListView fx:id="playerInList" layoutX="255.0" layoutY="372.0" prefHeight="110.0" prefWidth="195.0" AnchorPane.leftAnchor="255.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="372.0" />

        <Button layoutX="50.0" layoutY="490.0" mnemonicParsing="false" onMouseClicked="#substitutebutton" prefHeight="28.0" prefWidth="160.0" style="-fx-background-color: #ffcc88; -fx-font-weight: bold;" text="Make Substitution" AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="50.0" />

        <!-- Continue button -->
        <Button fx:id="continueBtn" layoutX="290.0" layoutY="490.0" mnemonicParsing="false" onMouseClicked="#continuebutton" prefHeight="28.0" prefWidth="160.0" style="-fx-background-color: LIGHTGREEN; -fx-font-weight: bold;" text="Continue 2nd Half" AnchorPane.bottomAnchor="52.0" AnchorPane.rightAnchor="50.0" />

    </children>
    <effect>
        <DropShadow>
            <color>
                <Color red="0.0873294323682785" green="0.8421052694320679" blue="0.26344379782676697" />
            </color>
        </DropShadow>
    </effect>
</AnchorPane>
