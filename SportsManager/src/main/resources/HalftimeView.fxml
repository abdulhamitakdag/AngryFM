<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-border-color: PINK; -fx-background-color: LIGHTYELLOW;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sportsmanager.ui.HalftimeController">
    <children>
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="150.0" layoutY="20.0" prefHeight="34.0" prefWidth="200.0" text="HALF TIME" textFill="#009487" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="20.0">
            <font><Font size="17.0" /></font>
            <effect><Glow level="0.96" /></effect>
        </Label>

        <VBox alignment="CENTER" layoutX="50.0" layoutY="60.0" prefWidth="400.0" spacing="4.0" style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #888; -fx-border-radius: 6;" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="60.0">
            <children>
                <Label fx:id="scorelabel" style="-fx-font-weight: bold; -fx-font-size: 18;" text="-" />
                <Label fx:id="firsthalfsumlabel" style="-fx-font-size: 11; -fx-text-fill: #555;" text="First half result" />
            </children>
        </VBox>

        <Label layoutX="50.0" layoutY="160.0" style="-fx-text-fill: #555; -fx-font-size: 11;" text="Current Tactic" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="160.0" />
        <Label fx:id="currenttacticlabel" layoutX="50.0" layoutY="178.0" style="-fx-font-weight: bold; -fx-font-size: 13;" text="-" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="178.0" />

        <Label layoutX="50.0" layoutY="208.0" style="-fx-text-fill: #555; -fx-font-size: 11;" text="Switch Tactic for 2nd Half" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="208.0" />
        <ListView fx:id="tacticlist" layoutX="50.0" layoutY="225.0" prefHeight="100.0" prefWidth="400.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="225.0" />

        <Button layoutX="50.0" layoutY="335.0" mnemonicParsing="false" onMouseClicked="#applybutton" prefHeight="34.0" prefWidth="180.0" style="-fx-background-color: SKYBLUE; -fx-font-weight: bold;" text="Apply Tactic" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="50.0" />
        <Button layoutX="270.0" layoutY="335.0" mnemonicParsing="false" onMouseClicked="#continuebutton" prefHeight="34.0" prefWidth="180.0" style="-fx-background-color: LIGHTGREEN; -fx-font-weight: bold;" text="Continue 2nd Half" AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="50.0" />
    </children>
    <effect>
        <DropShadow>
            <color>
                <Color red="0.0873294323682785" green="0.8421052694320679" blue="0.26344379782676697" />
            </color>
        </DropShadow>
    </effect>
</AnchorPane>
